{
  "name": "clipboard-extractor",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js web app that reads the clipboard and extracts structured data into a table.",
  "scripts": {
    "dev": "node scripts/bundle-source.ts && next dev",
    "build": "node scripts/bundle-source.ts && next build",
    "start": "node scripts/serve.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
